{
  "Config": "dev",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "InternalServiceSettings": {
    "HeaderName": "X-Internal-Service-Key",
    "Secret": "development-internal-service-shared-secret"
  },
  "FeatureManagement": {
    "EnableDev": true,
    "EnableSwagger": true,
    "EnableCache": false,
    "EnableOutputCache": false,
    "EnableMock": true,
    "EnableKeyVault": false
  }
}
