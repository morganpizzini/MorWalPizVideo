<Window x:Class="MorWalPiz.VideoImporter.Views.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MorWalPiz.VideoImporter.Views"
        mc:Ignorable="d"
        Title="Impostazioni"
        Height="550"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Channel Settings Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="⚙️ Impostazioni del canale"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Application Name"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="ApplicationNameTextBox"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="Hashtag Predefiniti"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Inserisci gli hashtag separati da virgola (esempio: video, social)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>
                    <TextBox x:Name="HashtagsTextBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="120"/>
                    <TextBlock x:Name="ChannelSettingsStatusTextBlock"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Stato salvataggio impostazioni canale"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Local Connection Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="🔗 Connessione locale a BackOffice"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Endpoint e chiave restano su questo computer e non vengono sincronizzati."
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"/>
                    
                    <!-- API Endpoint -->
                    <TextBlock Text="API Endpoint"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="ApiEndpointTextBox"
                             Margin="0,0,0,15"/>
                    <!-- API Key -->
                    <TextBlock Text="API Key"
            FontWeight="SemiBold"
            Margin="0,0,0,5"/>
                    <TextBox x:Name="ApiKeyTextBox"
          Margin="0,0,0,15"/>
                    <StackPanel>
                        <TextBlock x:Name="LocalConnectionStatusTextBlock"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   AutomationProperties.Name="Stato connessione locale"
                                   AutomationProperties.LiveSetting="Assertive"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button x:Name="SaveConnectionButton"
                                Content="Salva connessione locale"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right"
                                Click="SaveConnectionButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Style="{StaticResource DialogFooter}">
                <Button x:Name="SaveButton"
                        Content="💾 Salva"
                        Style="{StaticResource PrimaryButton}"
                        Width="100"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Annulla"
                        Style="{StaticResource SecondaryButton}"
                        Width="100"
                        Margin="10,0,0,0"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>