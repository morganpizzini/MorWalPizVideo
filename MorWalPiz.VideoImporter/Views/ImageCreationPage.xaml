<Window x:Class="MorWalPiz.VideoImporter.Views.ImageCreationPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creazione immagini" Height="760" Width="980" MinHeight="600" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Creazione immagini" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,18"/>
                <TextBlock Text="Nome" FontWeight="SemiBold"/><TextBox x:Name="NameTextBox" Margin="0,5,0,12"/>
                <TextBlock Text="Prompt" FontWeight="SemiBold"/><TextBox x:Name="PromptTextBox" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,5,0,12"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Salva template" Click="SaveTemplate_Click" Margin="0,0,8,0"/>
                    <Button Content="Elimina template" Click="DeleteTemplate_Click" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
                <TextBlock Text="Template globali" FontWeight="SemiBold"/><ComboBox x:Name="TemplateComboBox" DisplayMemberPath="Name" SelectionChanged="TemplateComboBox_SelectionChanged" Margin="0,5,0,14"/>
                <TextBlock Text="Formato configurato" FontWeight="SemiBold"/><ComboBox x:Name="SizeComboBox" Margin="0,5,0,12"/>
                <TextBlock Text="Qualità" FontWeight="SemiBold"/><TextBox x:Name="QualityTextBox" Margin="0,5,0,12"/>
                <TextBlock Text="Sfondo" FontWeight="SemiBold"/><TextBox x:Name="BackgroundTextBox" Margin="0,5,0,12"/>
                <TextBlock Text="Immagine sorgente (editing, una sola)" FontWeight="SemiBold"/><TextBox x:Name="SourceTextBox" IsReadOnly="True" Margin="0,5,0,5"/>
                <Button Content="Scegli immagine" Click="ChooseSource_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12"/>
                <TextBlock Text="Maschera opzionale" FontWeight="SemiBold"/><TextBox x:Name="MaskTextBox" IsReadOnly="True" Margin="0,5,0,5"/>
                <Button Content="Scegli maschera" Click="ChooseMask_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12"/>
                <TextBlock Text="Directory output configurata" FontWeight="SemiBold"/><TextBlock x:Name="OutputDirectoryTextBlock" TextWrapping="Wrap" Margin="0,5,0,16"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="GenerateButton" Content="Genera" Click="Generate_Click" Margin="0,0,8,0"/>
                    <Button x:Name="EditButton" Content="Modifica" Click="Edit_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="CancelButton" Content="Annulla" Click="Cancel_Click" Style="{StaticResource DangerButton}" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Anteprima" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ListBox x:Name="OutputListBox" DockPanel.Dock="Bottom" Height="100" DisplayMemberPath="FileName"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="Uniform"/></ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>