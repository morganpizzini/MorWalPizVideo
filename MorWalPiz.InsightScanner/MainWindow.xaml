<Window x:Class="MorWalPiz.InsightScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MorWalPiz Insight Scanner" Height="800" Width="1200" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left panel: topic/source selection, batches and scan trigger -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Topic" FontWeight="Bold" />
            <ComboBox x:Name="TopicComboBox" DisplayMemberPath="Title" Margin="0,4,0,10"
                      SelectionChanged="TopicComboBox_SelectionChanged" />

            <TextBlock Text="Fonti del topic" FontWeight="Bold" />
            <ComboBox x:Name="SourceComboBox" Margin="0,4,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Max post per fonte:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="MaxPostsTextBox" Width="50" Text="5" />
            </StackPanel>

            <Button x:Name="AutoCollectButton" Content="Recupera automaticamente (fonti pubbliche)"
                    Margin="0,0,0,6" Click="AutoCollectButton_Click" />
            <Button x:Name="BrowserCollectButton" Content="Raccogli post dalla pagina nel browser"
                    Margin="0,0,0,6" Click="BrowserCollectButton_Click" />
            <Button x:Name="NavigateButton" Content="Vai alla fonte selezionata nel browser"
                    Margin="0,0,0,10" Click="NavigateButton_Click" />

            <TextBlock Text="Post raccolti in questa sessione" FontWeight="Bold" />
            <ListBox x:Name="CollectedBatchesListBox" Height="220" Margin="0,4,0,10" />

            <Button x:Name="RunScanButton" Content="Esegui Scansione Manuale" Margin="0,0,0,10"
                    Click="RunScanButton_Click" />

            <TextBlock Text="Risultato" FontWeight="Bold" />
            <TextBox x:Name="ResultTextBox" Height="180" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" IsReadOnly="True" />
        </StackPanel>

        <!-- Right panel: interactive browser session (manual login/navigation by the user) -->
        <wv2:WebView2 x:Name="Browser" Grid.Column="1" />
    </Grid>
</Window>
