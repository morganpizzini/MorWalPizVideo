{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeatureManagement": {
    "EnableDev": false,
    "EnableMock": false
  },
  "FreezerAnalysis": {
    "ApplicationDatabaseName": "",
    "ApplyIndexesOnStartup": false,
    "MaximumUploadBytes": 20971520,
    "PdfTextExtractorPath": "pdftotext",
    "PrivateBlob": {
      "Endpoint": "",
      "ContainerName": "freezer-analysis-private",
      "UseManagedIdentity": true
    }
  }
}
