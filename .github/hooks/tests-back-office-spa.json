{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "matcher": "edit|create|apply_patch",
        "bash": "node .github/hooks/scripts/run-related-tests.cjs back-office-spa",
        "powershell": "node .github/hooks/scripts/run-related-tests.cjs back-office-spa",
        "timeoutSec": 600
      }
    ]
  }
}
